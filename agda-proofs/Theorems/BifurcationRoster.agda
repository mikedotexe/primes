------------------------------------------------------------------------
-- 1. Bifurcation tags: certified vs exceptional
------------------------------------------------------------------------

-- The two regimes in the bifurcation architecture:
--
--   CertifiedUniversal:  k* = 0 for all M (proven via DualCertificate)
--   ExceptionalFrontier: ≥1 elbow detected (empirical ridge_extractor)

data Regime : Set where
  CertifiedUniversal  : Regime
  ExceptionalFrontier : Regime

------------------------------------------------------------------------
-- 2. Window identification key
------------------------------------------------------------------------

-- Minimal key identifying a residue window by (base, outer, inner).
-- This allows us to cross-reference ElbowConfig instances with
-- certified window data.

record WindowKey : Set where
  constructor mkWindowKey
  field
    baseK  : ℕ
    outerK : ℕ
    innerK : ℕ

open WindowKey public

-- Extract the window key from an elbow configuration

keyOfConfig : ElbowConfig → WindowKey
keyOfConfig c = mkWindowKey (base c) (outer c) (inner c)

------------------------------------------------------------------------
-- 3. Frontier roster from GlobalElbowFacts
------------------------------------------------------------------------

-- The current collab package has exactly one elbow event from
-- ridge_elbows.csv:
--
--   Base 15, (outer,inner) = (13,1), M=1→2, k=0→1
--
-- This is auto-generated by generate_elbow_agda_from_csv.py as:
--
--   elbow_b15_o13_i1_M1_to_M2_k0_to_k1 : ElbowEvent
--
-- in ElbowsFromCSV.agda, and designated as the flagship elbow in
-- GlobalElbowFacts.agda as `frontierElbow`.

-- We import frontierElbow from GlobalElbowFacts (no need to redefine)
open Theorems.GlobalElbowFacts using (frontierElbow)

frontierKey : WindowKey
frontierKey = keyOfConfig (cfg frontierElbow)

-- For this package (1 config, 1 elbow), the frontier roster is just
-- this single event. As ridge_elbows.csv grows, this list will expand
-- via allElbowEvents from ElbowsFromCSV.

frontierElbows : List ElbowEvent
frontierElbows = frontierElbow ∷ []

frontierRegime : Regime
frontierRegime = ExceptionalFrontier

------------------------------------------------------------------------
-- 4. Certified windows: placeholder for future integration
------------------------------------------------------------------------

-- A "certified window" is a residue window for which we have a
-- DualCertificate from the Abstract framework (WindowCertificate /
-- CertifiedResonanceComplete).
--
-- In the current collab snapshot:
--   - All certified examples (base 6, etc.) live in agda-proofs/
--   - They are NOT the (15,13,1) configuration analyzed here
--   - ridge_statistics.txt reports 0 certified universal configs
--
-- So for this package, the certified roster is empty, matching the
-- documented bifurcation split.

-- Minimal concrete type for future WindowCertificate integration.
-- When the Abstract framework is wired in, this will be extended with:
--   n    : ℕ
--   cert : DualCertificate n
--
-- For now, we just track the window key.

record CertifiedWindow : Set where
  constructor mkCertifiedWindow
  field
    key : WindowKey

open CertifiedWindow public

certifiedWindows : List CertifiedWindow
certifiedWindows = []

