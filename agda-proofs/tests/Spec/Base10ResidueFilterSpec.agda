{-# OPTIONS --safe --without-K #-}

{-|
  Test Specification: Base 10 Residue Filter

  This module tests the base-10 residue theorem by applying it to concrete primes
  and verifying that results normalize to refl.

  REQUIREMENTS:
  - Base10ResidueFilter.prime-residue-theorem must be completely proven (no holes)
  - All primality postulates must be available

  STATUS: Awaiting completion of prime-residue-theorem proof
  EXPECTED: This will compile and all tests will pass once the theorem is complete

  Pattern: Each test invokes the theorem on a specific prime and specific bound proof.
  Success means the function call normalizes to refl, validating both:
    1. The theorem computes correctly
    2. The specific prime satisfies the theorem's claim
-}

module Tests.Spec.Base10ResidueFilterSpec where

open import Data.Nat using (ℕ; zero; suc; _<_)
open import Data.Nat.Properties using (z≤n; s≤s)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Data.Bool using (Bool; true; false)

-- Import the module under test
open import Base10ResidueFilter
  renaming (IsPrime to Prime)

-------------------------------------------------------------------------------
-- Primality Facts
-------------------------------------------------------------------------------

-- These facts assert that specific numbers are prime.
-- In a complete system, these would either:
--   1. Be proven from a primality checking algorithm
--   2. Be generated by a verified sieve
--   3. Come from a primality certificate library
--
-- For now, we postulate them to enable test structure.

postulate
  prime-11 : Prime 11
  prime-13 : Prime 13
  prime-17 : Prime 17
  prime-19 : Prime 19
  prime-23 : Prime 23
  prime-29 : Prime 29
  prime-31 : Prime 31
  prime-37 : Prime 37

-------------------------------------------------------------------------------
-- Inequality Proofs
-------------------------------------------------------------------------------

-- Proofs that 10 < n for each test case
-- These are explicit successor chains: 0 < 1 < 2 < ... < 10 < n

10<11 : 10 < 11
10<11 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n)))))))))

10<13 : 10 < 13
10<13 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n)))))))))))

10<17 : 10 < 17
10<17 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))

10<19 : 10 < 19
10<19 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))))

10<23 : 10 < 23
10<23 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))))))))

10<29 : 10 < 29
10<29 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))))))))))))))

10<31 : 10 < 31
10<31 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))))))))))))))))

10<37 : 10 < 37
10<37 = s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s (s≤s z≤n))))))))))))))))))))))))))))))))))))

-------------------------------------------------------------------------------
-- Test Cases
-------------------------------------------------------------------------------

-- Each test applies prime-residue-theorem to a specific prime
-- When the theorem is complete, these will normalize to refl

-- Test: 11 is prime and 11 > 10, so valid-prime-residue 11 must be true
test-11 : valid-prime-residue 11 ≡ true
test-11 = prime-residue-theorem 11 prime-11 10<11

-- Test: 13 is prime and 13 > 10, so valid-prime-residue 13 must be true
test-13 : valid-prime-residue 13 ≡ true
test-13 = prime-residue-theorem 13 prime-13 10<13

-- Test: 17 is prime and 17 > 10, so valid-prime-residue 17 must be true
test-17 : valid-prime-residue 17 ≡ true
test-17 = prime-residue-theorem 17 prime-17 10<17

-- Test: 19 is prime and 19 > 10, so valid-prime-residue 19 must be true
test-19 : valid-prime-residue 19 ≡ true
test-19 = prime-residue-theorem 19 prime-19 10<19

-- Test: 23 is prime and 23 > 10, so valid-prime-residue 23 must be true
test-23 : valid-prime-residue 23 ≡ true
test-23 = prime-residue-theorem 23 prime-23 10<23

-- Test: 29 is prime and 29 > 10, so valid-prime-residue 29 must be true
test-29 : valid-prime-residue 29 ≡ true
test-29 = prime-residue-theorem 29 prime-29 10<29

-- Test: 31 is prime and 31 > 10, so valid-prime-residue 31 must be true
test-31 : valid-prime-residue 31 ≡ true
test-31 = prime-residue-theorem 31 prime-31 10<31

-- Test: 37 is prime and 37 > 10, so valid-prime-residue 37 must be true
test-37 : valid-prime-residue 37 ≡ true
test-37 = prime-residue-theorem 37 prime-37 10<37

