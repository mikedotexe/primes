def payload : GeneratedWindowPayload 10 where
  p := 5
  windowMid := 50
  radius := 1
  residues := [7, 3]
  positions := [47, 53]

abbrev window : WindowData 10 payload.residues.length := payload.windowData

theorem balanced :
    ∀ r, payload.derivedCount r = payload.derivedCount (reflect 10 r) := by
  intro r
  fin_cases r <;> native_decide

def fixedPointExclusion : PrimeArithmetic.Symmetry.CertificateReflection.ObservedFixedPointExclusion payload.residueFn where
  zeroVoid := by
    intro i
    fin_cases i <;> native_decide
  midpointVoid := by
    intro i
    fin_cases i <;> native_decide

theorem pointwiseSafe :
    PointwiseSafe payload.radius payload.windowMid payload.positions := by
  intro x hx
  simp [payload, SafePos] at hx ⊢
  rcases hx with rfl | rfl
  all_goals native_decide

def evidence : GeneratedDualEvidence payload where
  balanced := balanced
  fixedPointExclusion := fixedPointExclusion
  pointwiseSafe := pointwiseSafe

theorem midpoint_residue_not_in_range :
    midpoint 10 ∉ Set.range window.residue :=
  evidence.midpoint_not_in_range (hEven := show Even 10 by native_decide)

theorem zero_residue_not_in_range :
    (0 : Fin 10) ∉ Set.range window.residue :=
  evidence.zero_not_in_range (hEven := show Even 10 by native_decide)

theorem window_inviolability :
    InZone payload.radius payload.windowMid payload.positions → False :=
  evidence.inviolability (hEven := show Even 10 by native_decide)

end PrimeArithmetic.Generated.Examples.WindowP5Base10Span5
